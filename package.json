{
  "name": "leftoff-agents",
  "version": "0.1.0",
  "description": "Leftoff Agents — pick up where your AI coding agents left off. A project manager for your coding agents.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "project-management",
    "telegram",
    "cli",
    "paseo",
    "developer-tools"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Maurizio Caporali",
    "url": "https://github.com/maubau"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maubau/leftoff-agents.git"
  },
  "bugs": {
    "url": "https://github.com/maubau/leftoff-agents/issues"
  },
  "homepage": "https://github.com/maubau/leftoff-agents#readme",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "leftoff": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/web/public && cp -r src/web/public dist/web/public",
    "prepack": "npm run build",
    "dev": "node src/cli.ts",
    "test": "env -u CLAUDECODE -u CLAUDE_CODE_SESSION_ID -u PASEO_AGENT_ID -u CLAUDE_CONFIG_DIR -u CODEX_SANDBOX -u LEFTOFF_AGENT node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "commander": "^15.0.0",
    "grammy": "^1.46.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
